{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://github.com/gasyoun/VisualDCS/visual/contracts/v1/schemas/concordance-passage.schema.json",
  "title": "VisualDCS v1 concordance-passage learner contract",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contractVersion", "corpusRelease", "generatedBy", "passageCount",
    "passages", "links", "unresolved"
  ],
  "properties": {
    "contractVersion": { "type": "string", "pattern": "^1\\.\\d+\\.\\d+$" },
    "corpusRelease": { "type": "string" },
    "generatedBy": { "type": "string" },
    "passageCount": { "type": "integer", "minimum": 0 },
    "passages": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["passageId", "sourceId", "title", "genre", "diff", "desc", "src", "txt", "vd", "linkedFormCount"],
        "properties": {
          "passageId": { "type": "string", "pattern": "^vdcs:v1:passage:[^:]+:.+$" },
          "sourceId": { "type": "integer", "minimum": 0 },
          "title": { "type": "string", "minLength": 1 },
          "genre": { "type": "string" },
          "diff": { "type": "integer" },
          "desc": { "type": "string" },
          "src": { "type": "string", "minLength": 1 },
          "txt": { "type": "string", "minLength": 1 },
          "vd": { "type": "number" },
          "linkedFormCount": { "type": "integer", "minimum": 0 }
        }
      }
    },
    "links": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["form", "passageId", "exampleText", "occurrences"],
        "properties": {
          "form": { "type": "string", "minLength": 1 },
          "passageId": { "type": "string", "pattern": "^vdcs:v1:passage:[^:]+:.+$" },
          "exampleText": { "type": "string", "minLength": 1 },
          "occurrences": { "type": "integer", "minimum": 1 }
        }
      }
    },
    "unresolved": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "totalCitationsScanned", "resolvedCitations", "unresolvedCitations",
        "distinctUnresolvedCitationStrings", "passagesWithZeroLinks", "note"
      ],
      "properties": {
        "totalCitationsScanned": { "type": "integer", "minimum": 0 },
        "resolvedCitations": { "type": "integer", "minimum": 0 },
        "unresolvedCitations": { "type": "integer", "minimum": 0 },
        "distinctUnresolvedCitationStrings": { "type": "integer", "minimum": 0 },
        "passagesWithZeroLinks": {
          "type": "array",
          "items": { "type": "integer", "minimum": 0 }
        },
        "note": { "type": "string" }
      }
    }
  }
}
